VULNIFY_API_KEY=vln_test_your_key_here
# Agent name in your Vulnify organization. A new name registers on first use.
VULNIFY_AGENT=support-agent
# Gemini key for a live model. Leave the placeholder to keep the scripted planner.
GOOGLE_API_KEY=your_google_api_key_here
# Optional. Used only when GOOGLE_API_KEY is a real key.
GOOGLE_MODEL=gemini-3.5-flash
